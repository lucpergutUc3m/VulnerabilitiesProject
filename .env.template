# ============================================
# PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# ============================================
# Copy this file to .env and fill in production values
# NEVER commit .env with real credentials to git!
# ============================================

# ============================================
# DATABASE CONFIGURATION
# ============================================
# PostgreSQL database name for production
POSTGRES_DB=vulnerableappdb_prod

# PostgreSQL username - use a strong, unique username
POSTGRES_USER=prod_user

# PostgreSQL password - MUST be strong (min 32 characters)
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD_MIN_32_CHARS

# PostgreSQL port (default: 5432)
POSTGRES_PORT=5432

# ============================================
# SPRING BOOT / BACKEND CONFIGURATION
# ============================================
# Database connection URL
# For Docker: use service name (postgres)
# For external DB: use actual host/IP
DB_URL=jdbc:postgresql://postgres:5432/vulnerableappdb_prod

# Database credentials (should match POSTGRES_* variables above)
DB_USERNAME=prod_user
DB_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD_MIN_32_CHARS

# Hibernate DDL mode
# PRODUCTION: Must be 'validate' (never create/update in prod!)
# DEVELOPMENT: Can be 'update' or 'create-drop'
DDL_AUTO=validate

# Server port for Spring Boot application
SERVER_PORT=8080

# ============================================
# JWT CONFIGURATION (CRITICAL FOR SECURITY!)
# ============================================
# JWT Secret Key - MUST be changed to a secure random string
# Minimum 256 bits (32 bytes) for HS256 algorithm
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_TO_SECURE_RANDOM_STRING_MIN_256_BITS

# JWT token expiration time in milliseconds
# Default: 3600000 (1 hour)
# 86400000 = 24 hours
JWT_EXPIRATION=3600000

# JWT issuer (application identifier)
JWT_ISSUER=VulnerableApp

# JWT audience (who can use this token)
JWT_AUDIENCE=VulnerableApp-Users

# ============================================
# CORS CONFIGURATION
# ============================================
# Allowed origins for CORS (comma-separated)
# PRODUCTION: Set to your actual frontend domain(s)
# DEVELOPMENT: Can use http://localhost:5173
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ============================================
# FRONTEND CONFIGURATION
# ============================================
# API base URL for frontend to connect to backend
# PRODUCTION (same domain): Use /api
# PRODUCTION (different domain): Use https://api.yourdomain.com
# DEVELOPMENT: Use http://localhost:8080/api
VITE_API_URL=/api

# API request timeout in milliseconds
VITE_API_TIMEOUT=5000

# Application name displayed in frontend
VITE_APP_NAME=Cuestioneo

# Application version
VITE_APP_VERSION=1.0.0

# Environment (development, staging, production)
VITE_ENVIRONMENT=production

# Default language
VITE_DEFAULT_LANGUAGE=en

# Enable debug mode (should be false in production)
VITE_DEBUG=false

# ============================================
# SECURITY SETTINGS
# ============================================
# Vulnerability mode - MUST BE FALSE IN PRODUCTION!
# Only set to true for educational/testing purposes
VULNERABILITY_MODE=false

# Enable secure cookies (HTTPS required)
# PRODUCTION: Must be true
# DEVELOPMENT (HTTP): Can be false
COOKIE_SECURE=true

# ============================================
# LOGGING CONFIGURATION
# ============================================
# JPA SQL logging (should be false in production)
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false

# H2 Console (should be disabled in production)
H2_CONSOLE_ENABLED=false

# ============================================
# DOCKER COMPOSE CONFIGURATION
# ============================================
# Adminer port (database management UI)
# WARNING: Disable or restrict access in production!
ADMINER_PORT=8081

# ============================================
# PRODUCTION DEPLOYMENT CHECKLIST
# ============================================
# Before deploying to production, ensure:
# 
# 1. ✅ JWT_SECRET is set to a cryptographically secure random value
# 2. ✅ POSTGRES_PASSWORD is strong (min 32 characters)
# 3. ✅ DDL_AUTO is set to 'validate' (not update/create)
# 4. ✅ VULNERABILITY_MODE is set to false
# 5. ✅ CORS_ALLOWED_ORIGINS is restricted to your actual domain(s)
# 6. ✅ COOKIE_SECURE is set to true
# 7. ✅ SSL/TLS certificates are properly configured
# 8. ✅ JPA_SHOW_SQL is false
# 9. ✅ H2_CONSOLE_ENABLED is false
# 10. ✅ Adminer is disabled or access is restricted
# 11. ✅ Database backups are configured
# 12. ✅ Monitoring and logging are set up
# 13. ✅ Rate limiting is configured at reverse proxy level
# 14. ✅ Regular security updates are scheduled
# 
# ============================================
