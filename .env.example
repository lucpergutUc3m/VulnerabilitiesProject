# ============================================
# EXAMPLE ENVIRONMENT VARIABLES
# ============================================
# This file shows example values for all environment variables
# Copy .env.template to .env and customize for your environment
# ============================================

# Database Configuration
POSTGRES_DB=vulnerableappdb_prod
POSTGRES_USER=prod_user
POSTGRES_PASSWORD=your-secure-password-here-min-32-chars
POSTGRES_PORT=5432

# Spring Boot Configuration
DB_URL=jdbc:postgresql://postgres:5432/vulnerableappdb_prod
DB_USERNAME=prod_user
DB_PASSWORD=your-secure-password-here-min-32-chars
DDL_AUTO=validate
SERVER_PORT=8080

# JWT Configuration (generate with: openssl rand -base64 32)
JWT_SECRET=dGhpc19pc19hX3NhbXBsZV9zZWNyZXRfa2V5X3JlcGxhY2VfaW5fcHJvZHVjdGlvbg==
JWT_EXPIRATION=3600000
JWT_ISSUER=VulnerableApp
JWT_AUDIENCE=VulnerableApp-Users

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Frontend Configuration
VITE_API_URL=/api
VITE_API_TIMEOUT=5000
VITE_APP_NAME=Cuestioneo
VITE_APP_VERSION=1.0.0
VITE_ENVIRONMENT=production
VITE_DEFAULT_LANGUAGE=en
VITE_DEBUG=false

# Security Settings
VULNERABILITY_MODE=false
COOKIE_SECURE=true

# Logging
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false
H2_CONSOLE_ENABLED=false

# Docker
ADMINER_PORT=8081
