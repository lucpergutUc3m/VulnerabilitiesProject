# ========================================
# DEVELOPMENT ENVIRONMENT VARIABLES
# ========================================
# This file contains default values for LOCAL DEVELOPMENT ONLY
# DO NOT use these values in production!

# Database Configuration
POSTGRES_DB=vulnerableappdb
POSTGRES_USER=dbuser
POSTGRES_PASSWORD=dbpassword
POSTGRES_PORT=5432

# Adminer Configuration
ADMINER_PORT=8081
ADMINER_DESIGN=nette

# Spring Boot Application
DB_URL=jdbc:postgresql://localhost:5432/vulnerableappdb
DB_USERNAME=dbuser
DB_PASSWORD=dbpassword
DB_DRIVER=org.postgresql.Driver
DB_DIALECT=org.hibernate.dialect.PostgreSQLDialect
DB_DDL_AUTO=update

# JWT Configuration (WEAK - FOR DEVELOPMENT ONLY)
JWT_SECRET=dev-secret-key-change-this-in-production-min-256-bits-long
JWT_EXPIRATION=86400000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Debug Settings
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true
H2_CONSOLE_ENABLED=true

# Server Configuration
SERVER_PORT=8080

# Vulnerability Mode (for testing only)
VULNERABILITY_MODE=false
