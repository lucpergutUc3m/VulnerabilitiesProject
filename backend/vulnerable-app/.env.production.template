# ========================================
# PRODUCTION ENVIRONMENT VARIABLES
# ========================================
# CRITICAL: Set these values in your production environment!
# NEVER commit this file with real production values!

# Database Configuration - USE STRONG PASSWORDS!
POSTGRES_DB=vulnerableappdb_prod
POSTGRES_USER=prod_user
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD_MIN_32_CHARS
POSTGRES_PORT=5432

# Adminer - DISABLE IN PRODUCTION!
# Adminer should NOT be exposed in production
# Use the 'dev' profile to disable it

# Spring Boot Application
DB_URL=jdbc:postgresql://postgres:5432/vulnerableappdb_prod
DB_USERNAME=prod_user
DB_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD_MIN_32_CHARS
DB_DRIVER=org.postgresql.Driver
DB_DIALECT=org.hibernate.dialect.PostgreSQLDialect
DB_DDL_AUTO=validate

# JWT Configuration - MUST BE CHANGED!
# Generate a secure random string (min 256 bits / 32 bytes)
# Example: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_TO_SECURE_RANDOM_STRING_USE_OPENSSL_RAND_BASE64_32
JWT_EXPIRATION=3600000

# CORS Configuration - Set to your production frontend URL
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Debug Settings - MUST BE FALSE IN PRODUCTION
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false
H2_CONSOLE_ENABLED=false

# Server Configuration
SERVER_PORT=8080

# Vulnerability Mode - MUST BE FALSE IN PRODUCTION
VULNERABILITY_MODE=false
